{
  "labels": [
    "renovate"
  ],
  "extends": [
    ":separateMajorReleases",
    ":ignoreUnstable",
    ":prNotPending",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeTypes",
    ":automergePr"
  ],
  "prNotPendingHours": 1,
  "schedule": "before 1pm on Monday",
  "timezone": "Asia/Tokyo",
  "packageRules": [
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "groupName": "monorepo:types",
      "matchPackageNames": [
        "^@types/"
      ],
      "automerge": true
    },
    {
      "groupName": "monorepo:lint-plugin",
      "matchPackageNames": [
        "/^eslint-/"
      ],
      "automerge": true
    }
  ]
}
